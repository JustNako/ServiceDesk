{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/ServiceDesk.db"
  },
  "AllowedHosts": "*",

  "JwtSettings": {
    "Key": "your-secret-key-that-should-be-long",
    "Issuer": "ServiceDesk",
    "Audience": "ServiceDeskClient",
    "ExpiresInMinutes": 60
  } 
}
