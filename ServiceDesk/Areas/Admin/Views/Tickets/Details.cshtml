@using System.IO
@using ServiceDesk.Helpers
@using ServiceDesk.Entities;
@model ServiceDesk.Entities.TicketModels

@{
    ViewData["Title"] = "Детали заявки";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var phones = ViewBag.ContactPhones as List<string> ?? new();
    var attachments = ViewBag.Attachments as List<string> ?? new();
}

<h2 class="mb-4">📋 Заявка @Model.TicketNumber</h2>

<div class="mb-3">
    <strong>Тема:</strong>
    <div>@Model.Subject</div>
</div>

<div class="mb-3">
    <strong>Тип жалобы:</strong>
    <span class="badge bg-secondary">@Model.ComplainType.GetDescription()</span>
</div>

<div class="mb-3">
    <strong>Контактные номера:</strong>
    <ul>
        @foreach (var phone in phones)
        {
            <li>@phone</li>
        }
    </ul>
</div>

<div class="mb-3">
    <strong>Описание:</strong>
    <div>@Model.Description</div>
</div>

<div class="mb-3">
    <strong>Статус:</strong>
    <span class="badge @Model.Status.GetBadgeClass()">@Model.Status.GetDescription()</span>
</div>

@if (attachments.Any())
{
    <h5>📎 Вложения:</h5>
    <ul>
        @foreach (var filePath in attachments)
        {
            var fileName = System.IO.Path.GetFileName(filePath);
            <li>
                <a href="@filePath" target="_blank">
                    <i class="fas fa-file me-1"></i> @fileName
                </a>
            </li>
        }
    </ul>
}



<a asp-action="EditStatus" asp-route-id="@Model.Id" class="btn btn-warning">✏️ Изменить статус</a>
<a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">🗑 Удалить</a>

<hr />
<a asp-action="Index" class="btn btn-secondary">← Назад</a>
