@model ServiceDesk.ViewModels.TicketFilterViewModel  
@using ServiceDesk.Helpers  
@using ServiceDesk.Entities  
@using System.ComponentModel; 

@{  
    ViewData["Title"] = "Все заявки";  
    Layout = "~/Views/Shared/_AdminLayout.cshtml";  
}  

<h2 class="mb-4">📬 Все заявки</h2>  

<a class="btn btn-success mb-3" asp-area="Admin" asp-controller="Tickets" asp-action="Create">➕ Новая заявка</a>  

<form method="get" class="row g-2 mb-4">  
    <div class="col-md-4">  
        <input type="text" name="subject" value="@Model.Subject" class="form-control" placeholder="🔍 Поиск по теме" />  
    </div>  
    <div class="col-md-3">          
        <select name="complaintType" class="form-select">  
            <option value="">Тип жалобы</option>  
            @foreach (var type in Enum.GetValues(typeof(ComplainType)).Cast<ComplainType>())
            {
                int count = (ViewBag.ComplaintTypeCounts as Dictionary<ComplainType, int>)?.GetValueOrDefault(type) ?? 0;
    
                <option value="@type" selected="@(Model.ComplaintType == type ? "selected" : null)">
                    @type.GetDescription() (@count)
                </option>
            }


        </select>
    </div>  
    <div class="col-md-3">  
        <select name="status" class="form-select">  
            <option value="">Статус</option>  
            @foreach (var status in Enum.GetValues(typeof(TicketStatus)).Cast<TicketStatus>())  
            {  
                var count = ViewBag.StatusCounts != null && ViewBag.StatusCounts.ContainsKey(status) 
                            ? ViewBag.StatusCounts[status] 
                            : 0;

                <option value="@status" selected="@(Model.Status == status ? "selected" : null)">  
                    @status.GetDescription() (@count)
                </option>  
            }  
        </select>
    </div>  
    <div class="col-md-2">  
        <button type="submit" class="btn btn-primary w-100">🔎 Поиск</button>  
    </div>  
</form>  

<table class="table table-bordered table-striped">  
    <thead class="table-dark">  
        <tr>  
            <th>№</th>  
            <th>Тема</th>  
            <th>Тип</th>  
            <th>Статус</th>  
            <th>Дата</th>  
        </tr>  
    </thead>  
    <tbody>  
        @foreach (var ticket in Model.Tickets)  
        {  
            <tr class="clickable-row" data-href="@Url.Action("Details", "Tickets", new { area = "Admin", id = ticket.Id })">  
                <td>@ticket.TicketNumber</td>  
                <td>@ticket.Subject</td>  
                <td>@ticket.ComplainType.GetDescription()</td>  
                <td>
                    <span class="badge @ticket.Status.GetBadgeClass()">@ticket.Status.GetDescription()</span>
                </td>  
                <td>@ticket.CreatedAt.ToString("dd-MM-yyyy HH:mm")</td>  
            </tr>  
        }  
    </tbody>  
</table>  

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center mt-4">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new {
                        page = i,
                        subject = Model.Subject,
                        complaintType = Model.ComplaintType,
                        status = Model.Status
                    })">@i</a>
                </li>
            }
        </ul>
    </nav>
}


@section Scripts {  
    <style>  
        .clickable-row {  
            cursor: pointer;  
            transition: background-color 0.2s ease;  
        }  

        .clickable-row:hover {  
            background-color: rgba(0, 0, 0, 0.05); /* слегка тёмный фон */  
        }  
    </style>  

    <script>  
        document.addEventListener("DOMContentLoaded", function () {  
            document.querySelectorAll('.clickable-row').forEach(row => {  
                row.addEventListener('click', function (e) {  
                    if (e.target.closest('a, button')) return;  
                    window.location = this.dataset.href;  
                });  
            });  
        });  
    </script>  
}
