@using ServiceDesk.ViewModels
@using ServiceDesk.Entities;
@using ServiceDesk.Helpers;
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-4">📊 Админ панель</h2>

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <h5 class="card-title">📬 Заявки</h5>
                <p class="card-text">Количество заявок: <strong>@ViewBag.TicketCount</strong></p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <h5 class="card-title">👥 Пользователи</h5>
                <p class="card-text">Количество пользователей: <strong>@ViewBag.UserCount</strong></p>
            </div>
        </div>
    </div>
</div>
