@model List<ServiceDesk.Entities.AppUser>
@{
    ViewData["Title"] = "Пользователи";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-4">👥 Все пользователи</h2>

<a class="btn btn-success mb-3" asp-action="Create">➕ Создать нового</a>

<table class="table table-bordered">
    <thead class="table-dark">        
        <tr> 
            <th>Логин</th>
            <th>Имя</th>
            <th>Телефоны</th>
        </tr>        
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr class="clickable-row" data-href="@Url.Action("Details", "Users", new { area = "Admin", id = user.Id })">
                <td>@user.UserName</td>
                <td>@user.FullName</td>
                <td>
                    @foreach (var phone in user.ContactPhones)
                    {
                        <div>@phone</div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll('.clickable-row').forEach(row => {
                row.style.cursor = 'pointer';
                row.addEventListener('click', function (e) {
                    if (e.target.closest('a, button')) return; // игнор если клик по кнопке
                    window.location = this.dataset.href;
                });
            });
        });
    </script>

    <style>
        .clickable-row {
            transition: background-color 0.2s ease;
        }

            .clickable-row:hover {
                background-color: rgba(0, 0, 0, 0.05);
            }
    </style>
}
